# ============================================================================
# ACN-VTSP Environment Configuration (.env.example)
# Copy to .env for local development: cp .env.example .env
# ============================================================================

# --- Core API & Security ---
PORT_API_GATEWAY=8080
PORT_CHAT_MODERATION_WS=8081
PORT_WHITEBOARD_YJS=8082
PORT_WEBHOOK_DISPATCHER=8083
PORT_MCP_SERVER=8084
PORT_FEED_RECOMMENDER=8085

JWT_SECRET_KEY=acn_vtsp_super_secret_jwt_signing_key_2026
HLS_AES128_MASTER_SECRET=0123456789abcdef0123456789abcdef
UNKEY_ROOT_KEY=unkey_local_dev_mock_key

# --- PostgreSQL 16 ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=acn_admin
POSTGRES_PASSWORD=acn_secret_password
POSTGRES_DB=acn_vtsp
DATABASE_URL=postgres://acn_admin:acn_secret_password@localhost:5432/acn_vtsp?sslmode=disable

# --- Redis Cluster / Instance ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant Vector Database ---
QDRANT_HTTP_URL=http://localhost:6333
QDRANT_GRPC_URL=localhost:6334

# --- ClickHouse Telemetry ---
CLICKHOUSE_HTTP_URL=http://localhost:8123
CLICKHOUSE_NATIVE_ADDR=localhost:9000
CLICKHOUSE_DB=acn_telemetry
CLICKHOUSE_USER=acn_ch_user
CLICKHOUSE_PASSWORD=acn_ch_password

# --- Apache Kafka Event Bus ---
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC_INGEST=video.ingest.object_created
KAFKA_TOPIC_PROGRESSIVE=video.transcode.progressive_ready
KAFKA_TOPIC_TRANSCODE_DONE=video.transcode.completed
KAFKA_TOPIC_AI_DONE=video.ai.completed

# --- Cloudflare R2 / MinIO S3 Object Storage ---
S3_ENDPOINT=http://localhost:9002
S3_REGION=auto
S3_ACCESS_KEY=acn_r2_access_key
S3_SECRET_KEY=acn_r2_secret_key
S3_RAW_BUCKET=acn-vtsp-raw
S3_PROCESSED_BUCKET=acn-vtsp-processed-media
CDN_PUBLIC_BASE_URL=http://localhost:9002/acn-vtsp-processed-media

# --- LiveKit WebRTC SFU & MediaMTX LL-HLS ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LLHLS_PUBLIC_BASE_URL=http://localhost:8888

# --- Spot GPU AI Models ---
WHISPER_MODEL_SIZE=large-v3-turbo
TRANSLATION_MODEL=facebook/nllb-200-distilled-600M
TTS_MODEL=hexgrad/Kokoro-82M
YOLO_MODEL=yolo11n.pt
CLIP_MODEL=openai/clip-vit-base-patch32
LLM_PROVIDER_URL=http://localhost:11434/v1
GEMINI_API_KEY=your_gemini_api_key_here

